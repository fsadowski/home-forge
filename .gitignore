# ==============================================================================
# OpenTofu / Terraform
# ==============================================================================
# .terraform.lock.hcl is intentionally NOT ignored: commit it to pin providers.
.terraform/
.tofu/

# State can contain secrets in plain text
*.tfstate
*.tfstate.*

# Saved plans can contain secrets in plain text
*.tfplan
*.tfplan.json
tfplan
tfplan.*

# Variable values; commit a *.tfvars.example instead
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
override.tofu
override.tofu.json
*_override.tf
*_override.tf.json
*_override.tofu
*_override.tofu.json

# CLI configuration
.terraformrc
terraform.rc
.tofurc
tofu.rc

# Tooling
crash.log
crash.*.log
.terragrunt-cache/
.infracost/
.tflint.d/

# ==============================================================================
# Ansible
# ==============================================================================
# Vault-encrypted files are safe to commit; only the passwords are ignored here.
.vault_pass
.vault_pass.*
.vault-pass
.vault-pass.*
.vault_password
.vault_password.*
vault_pass.txt
vault-password.txt

*.retry
.ansible/
.ansible_cache/
fact_cache/
# Collections installed from requirements.yml (ADR-ANSIBLE-0001)
ansible/collections/
# The real inventory holds homelab addresses; commit hosts.example.yml instead
ansible/inventory/hosts.yml
.molecule/

# ==============================================================================
# Docker
# ==============================================================================
# Dockerfile, compose files and .dockerignore stay tracked.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Client configuration (may hold registry credentials)
.docker/

# Local bind-mount data
.data/
.volumes/

# Image archives from `docker save`
*.tar

